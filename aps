<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thiranex Task</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", Arial, sans-serif;
    }

    body {
      background: #f7f9fc;
      color: #273044;
    }

    /* Header */
    header {
      height: 135px;
      background: white;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 5%;
    }

    .logo {
      font-size: 42px;
      font-weight: 700;
      color: #2864d7;
      letter-spacing: -3px;
    }

    .logo small {
      display: block;
      font-size: 7px;
      letter-spacing: 1px;
      text-align: center;
      color: #5d6b7f;
      margin-top: -5px;
    }

    .header-buttons {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .refresh,
    .menu {
      width: 55px;
      height: 55px;
      border-radius: 15px;
      border: none;
      background: #f1f6ff;
      color: #2864d7;
      font-size: 25px;
      cursor: pointer;
    }

    .refresh {
      border-radius: 50%;
      background: white;
      box-shadow: 0 3px 15px rgba(0,0,0,0.08);
    }

    /* Main */
    .container {
      max-width: 680px;
      margin: 20px auto;
      background: white;
      border: 1px solid #e1e6ed;
      padding: 28px 38px 45px;
      min-height: 850px;
    }

    /* Top row */
    .top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
    }

    .number {
      width: 68px;
      height: 68px;
      border-radius: 17px;
      background: #eef5ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      font-weight: 700;
      color: #2864d7;
    }

    .status {
      background: #ffe0df;
      color: #a72d32;
      padding: 12px 20px;
      border-radius: 25px;
      font-weight: 700;
      font-size: 16px;
    }

    /* Due date */
    .date-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px dashed #dce1e8;
      padding-bottom: 22px;
      margin-bottom: 30px;
    }

    .date {
      font-size: 18px;
      color: #687386;
    }

    .date strong {
      color: #273044;
    }

    .overdue {
      background: #ffe1df;
      color: #a62c32;
      border-radius: 25px;
      padding: 10px 17px;
      font-size: 16px;
      font-weight: 700;
    }

    /* Title */
    h1 {
      font-size: 28px;
      line-height: 1.5;
      color: #141b2d;
      margin-bottom: 15px;
      font-weight: 800;
    }

    .description {
      font-size: 18px;
      line-height: 1.65;
      color: #4d586b;
      margin-bottom: 28px;
    }

    /* Tutorial */
    .tutorial {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      border: 1px solid #ffc8c8;
      background: #fff7f7;
      color: #d52f35;
      padding: 15px 25px;
      border-radius: 15px;
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 30px;
      cursor: pointer;
    }

    .youtube {
      background: #e60000;
      color: white;
      border-radius: 7px;
      padding: 2px 7px;
      font-size: 15px;
    }

    /* Sections */
    .section-title {
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .blue {
      color: #2864d7;
    }

    .green {
      color: #20ad87;
    }

    ul {
      padding-left: 30px;
      margin-bottom: 28px;
    }

    li {
      font-size: 17px;
      line-height: 1.6;
      color: #596476;
      margin-bottom: 10px;
    }

    .outcome {
      font-size: 18px;
      line-height: 1.65;
      color: #596476;
    }

    /* Submit */
    .submit-area {
      text-align: center;
      margin-top: 35px;
    }

    .submit {
      background: #2864df;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 8px;
      font-size